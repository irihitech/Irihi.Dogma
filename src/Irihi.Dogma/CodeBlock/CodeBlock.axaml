<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cb="using:Irihi.Dogma.Controls">
    <Style Selector="cb|CodeBlock">
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Container"
                        CornerRadius="6"
                        BorderBrush="#33000000"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock x:Name="PART_LineNumbers"
                                           Margin="12,10,8,10"
                                           TextAlignment="Right"
                                           VerticalAlignment="Top"
                                           FontFamily="Consolas, Cascadia Mono, Menlo, monospace"
                                           FontSize="13"
                                           LineHeight="18"/>
                                <SelectableTextBlock x:Name="PART_CodeText"
                                                     Grid.Column="1"
                                                     Margin="0,10,12,10"
                                                     FontFamily="Consolas, Cascadia Mono, Menlo, monospace"
                                                     FontSize="13"
                                                     LineHeight="18"/>
                            </Grid>
                        </ScrollViewer>
                        <Button x:Name="PART_CopyButton"
                                Content="Copy"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,6,6,0"
                                Padding="8,3"
                                FontSize="11"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
