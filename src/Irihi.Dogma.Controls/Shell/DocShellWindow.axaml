<u:UrsaWindow xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:u="https://irihi.tech/ursa"
              xmlns:dogma="using:Irihi.Dogma.Controls"
              xmlns:cvm="using:Irihi.Dogma.Controls.ViewModels"
              xmlns:lingua="https://irihi.tech/lingua"
              x:Class="Irihi.Dogma.Controls.DocShellWindow"
              x:DataType="cvm:DocShellViewModel"
              x:Name="Root"
              Title="{Binding Title^}"
              Width="1080" Height="720">
    <u:UrsaWindow.LeftContent>
        <TextBlock FontWeight="Bold"
                   IsHitTestVisible="False"
                   Text="{Binding Title^, FallbackValue=Hello}"
                   Margin="8 8 0 0" />
    </u:UrsaWindow.LeftContent>
    <u:UrsaWindow.RightContent>
        <StackPanel Orientation="Horizontal">
            <lingua:CulturePicker
                Managers="{Binding Managers}"
                MinWidth="100"
                Cultures="{Binding Cultures}">
                <lingua:CulturePicker.Styles>
                    <Style Selector="ComboBox">
                        <Setter Property="Background"
                                Value="Transparent" />
                        <Setter Property="BorderThickness"
                                Value="0" />
                    </Style>
                </lingua:CulturePicker.Styles>
            </lingua:CulturePicker>
            <u:ThemeToggleButton IsThreeState="True" />
        </StackPanel>
    </u:UrsaWindow.RightContent>
    <Panel
        Background="{DynamicResource SemiColorAIBackgroundTopActive}">
        <DockPanel HorizontalSpacing="12"
                   VerticalSpacing="12" Margin="12 36 12 12">
            <!-- 左侧：NavMenu（DocMenuViewModel 由 DocSite 分类树生成） -->
            <u:NavMenu ExpandWidth="300"
                       DockPanel.Dock="Left"
                       SubMenuBinding="{Binding Children}"
                       HeaderBinding="{Binding}"
                       SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                       ItemsSource="{Binding Menu.MenuItems}">
                <u:NavMenu.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="ListBoxItemSelectedBackground" ResourceKey="SemiAIGeneral2" />
                                <StaticResource x:Key="ListBoxItemSelectedForeground" ResourceKey="SemiColorBlack" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <StaticResource x:Key="ListBoxItemSelectedBackground" ResourceKey="SemiAIGeneral2" />
                                <StaticResource x:Key="ListBoxItemSelectedForeground" ResourceKey="SemiColorWhite" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </u:NavMenu.Resources>
                <u:NavMenu.Styles>
                    <Style
                        x:DataType="cvm:DocMenuItemViewModel"
                        Selector="u|NavMenuItem">
                        <Setter
                            Property="IsSeparator"
                            Value="{Binding IsSeparator}" />
                        <Setter
                            Property="IsVisible"
                            Value="{Binding IsVisible, Mode=TwoWay}" />
                    </Style>
                </u:NavMenu.Styles>
                <u:NavMenu.HeaderTemplate>
                    <DataTemplate
                        x:DataType="cvm:DocMenuItemViewModel">
                        <TextBlock
                            Text="{Binding MenuHeader^}"
                            ToolTip.Tip="{Binding MenuHeader^}"
                            TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </u:NavMenu.HeaderTemplate>
                <u:NavMenu.Header>
                    <StackPanel Spacing="8"
                                Margin="8 16">
                        <ContentPresenter
                            Content="{Binding HeaderIcon, ElementName=Root}"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding HeaderIcon, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBox
                            Text="{Binding SearchText}"
                            PlaceholderText="Search">
                            <TextBox.InnerLeftContent>
                                <PathIcon
                                    Theme="{DynamicResource InnerPathIcon}"
                                    Data="{DynamicResource SemiIconSearch}">
                                </PathIcon>
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </StackPanel>
                </u:NavMenu.Header>
            </u:NavMenu>
            <!-- 右侧：页面元信息（顶部）+ 内容区（页面视图经 VM 注入的 GeneratedViewLocator 解析） -->
            <Border
                Background="{DynamicResource WindowDefaultBackground}"
                CornerRadius="6"
                Padding="4"
                DockPanel.Dock="Top"
                IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNotNull}}"
                DataContext="{Binding PageMetadata}">
                <dogma:PageMetadataView />
            </Border>
            <Border
                Background="{DynamicResource WindowDefaultBackground}"
                CornerRadius="6"
                Padding="4">
                <ContentControl
                    Content="{Binding CurrentContent}"
                    ContentTemplate="{Binding ViewLocator}" />
            </Border>
        </DockPanel>
    </Panel>
</u:UrsaWindow>