<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dogma="using:Irihi.Dogma.Controls"
             xmlns:pages="using:Irihi.Dogma.Demo.Pages"
             x:Class="Irihi.Dogma.Demo.Pages.ButtonView"
             x:DataType="pages:ButtonViewModel">
    <dogma:AnchorScrollViewer AnchorItems="{Binding AnchorItems}">
        <StackPanel Spacing="20">
            <dogma:DemoSectionView SectionContext="{Binding BasicSection}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Click me"/>
                    <Button Classes="Primary" Content="Primary"/>
                    <Button Classes="Secondary" Content="Secondary"/>
                </StackPanel>
            </dogma:DemoSectionView>
            <dogma:DemoSectionView SectionContext="{Binding DisabledSection}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Disabled" IsEnabled="False"/>
                    <Button Classes="Primary" Content="Disabled Primary" IsEnabled="False"/>
                </StackPanel>
            </dogma:DemoSectionView>
        </StackPanel>
    </dogma:AnchorScrollViewer>
</UserControl>
