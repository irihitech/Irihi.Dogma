<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dogma="using:Irihi.Dogma.Controls"
             xmlns:pages="using:Irihi.Dogma.Demo.Pages"
             x:Class="Irihi.Dogma.Demo.Pages.InputView"
             x:DataType="pages:InputViewModel">
    <dogma:AnchorScrollViewer AnchorItems="{Binding AnchorItems}">
        <StackPanel Spacing="20">
            <dogma:DemoSectionView SectionContext="{Binding BasicSection}">
                <StackPanel Spacing="8" MaxWidth="300" HorizontalAlignment="Left">
                    <TextBox PlaceholderText="Enter your name"/>
                    <TextBox Text="Editable text"/>
                </StackPanel>
            </dogma:DemoSectionView>
            <dogma:DemoSectionView SectionContext="{Binding PasswordSection}">
                <StackPanel Spacing="8" MaxWidth="300" HorizontalAlignment="Left">
                    <TextBox PlaceholderText="Password" PasswordChar="●"/>
                </StackPanel>
            </dogma:DemoSectionView>
        </StackPanel>
    </dogma:AnchorScrollViewer>
</UserControl>
