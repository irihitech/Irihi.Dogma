<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cb="using:Irihi.Dogma.Controls"
             xmlns:local="using:Irihi.Dogma.Demo"
             xmlns:pages="using:Irihi.Dogma.Demo.Pages"
             x:Class="Irihi.Dogma.Demo.Pages.InputView"
             x:DataType="pages:InputViewModel">
    <StackPanel Spacing="16">
        <TextBlock Text="{Translate {x:Static local:LanguageManager+Keys.Docs_Input_Title}}"
                   FontSize="20" FontWeight="Bold"/>
        <StackPanel Spacing="8" MaxWidth="300" HorizontalAlignment="Left">
            <TextBox PlaceholderText="Enter your name"/>
            <TextBox Text="Editable text" />
            <TextBox PlaceholderText="Password" PasswordChar="●"/>
        </StackPanel>
        <TextBlock Text="Sample XAML:" FontWeight="Bold"/>
        <cb:CodeBlock Code="{Binding SampleCode}" Language="Axaml"/>
    </StackPanel>
</UserControl>
