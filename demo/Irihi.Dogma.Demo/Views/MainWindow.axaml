<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:docs="using:Irihi.Dogma.Docs"
        xmlns:local="using:Irihi.Dogma.Demo"
        xmlns:vm="using:Irihi.Dogma.Demo.ViewModels"
        xmlns:lingua="https://irihi.tech/lingua"
        x:Class="Irihi.Dogma.Demo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Translate {x:Static local:LanguageManager+Keys.App_Title}}"
        RequestedThemeVariant="{Binding RequestedTheme}"
        Width="1080" Height="720">
    <DockPanel Margin="0">
        <!-- 左侧：搜索 + 页面列表 -->
        <Border DockPanel.Dock="Left" Width="280" Padding="12" BorderBrush="#33000000" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBox DockPanel.Dock="Top"
                         PlaceholderText="{Translate {x:Static local:LanguageManager+Keys.Search_Placeholder}}"
                         Text="{Binding SearchText}"
                         Margin="0,0,0,8"/>
                <lingua:CulturePicker DockPanel.Dock="Top">
                    <lingua:CulturePicker.Managers>
                        <x:Static Member="local:LanguageManager.Instance" />
                    </lingua:CulturePicker.Managers>
                    <lingua:CulturePicker.Cultures>
                        <x:Static Member="lingua:LinguaCulture.InvariantCulture" />
                        <lingua:LinguaCulture Culture="zh-Hans" DisplayName="中文" />
                    </lingua:CulturePicker.Cultures>
                </lingua:CulturePicker>
                <ListBox ItemsSource="{Binding VisiblePages}"
                         SelectedItem="{Binding SelectedPage}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="docs:DocPageNode">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title^}"
                                           FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Metadata.TitleKey}"
                                           FontSize="11" Opacity="0.55"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <!-- 右侧：内容区（GeneratedViewLocator 按 VM 呈现对应 View） -->
        <ScrollViewer>
            <ContentControl Content="{Binding CurrentContent}" Margin="24" Padding="16">
                <ContentControl.ContentTemplate>
                    <docs:GeneratedViewLocator/>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </ScrollViewer>
    </DockPanel>
</Window>
